# ─────────────────────────────────────────────────────────────────────────────
# Talent3X frontend — environment
#
# FROZEN BUILD: every variable below is OPTIONAL. With none of them set, the app
# runs fully client-side (localStorage) with no backend — sign-in is a local demo
# session and Supabase calls hand back a no-op client (see src/lib/supabase/*).
# This is what deploys to a free host with zero secrets.
#
# Set the Supabase vars ONLY to reconnect the real backend when it is live — the
# client factory picks the real client up automatically when both NEXT_PUBLIC
# values are present.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (optional — omit for the no-backend build)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Misc (optional)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ENVELOPE_MASTER_KEY=
POLYGON_RPC_URL=
RELAYER_ENABLED=false
RELAYER_PRIVATE_KEY=
RELAYER_DEPLOYER_PRIVATE_KEY=
RELAYER_ADDRESS=
T3X_SKILL_RATINGS_CONTRACT_ADDRESS=
SITE_BASE=https://uni.talent3x.io
