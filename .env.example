# ─────────────────────────────────────────────────────────────────────────────
# Talent3X frontend — environment
#
# FROZEN BUILD: every variable below is OPTIONAL. By default the app runs fully
# client-side (localStorage) with no backend — sign-in is a local demo session and
# Supabase calls hand back a no-op client (see src/lib/supabase/*). This is what
# deploys to a free host with zero secrets.
#
# To reconnect the REAL backend you must OPT IN explicitly: set
# NEXT_PUBLIC_USE_SUPABASE=true AND provide the URL + anon key below. Merely having
# a URL in this file does nothing on its own — that way a leftover/old Supabase
# instance can't drag the frozen build back onto a server that may be paused.
# ─────────────────────────────────────────────────────────────────────────────

# Real backend opt-in (leave unset/false for the no-backend build)
NEXT_PUBLIC_USE_SUPABASE=false

# Supabase (only used when NEXT_PUBLIC_USE_SUPABASE=true)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Misc (optional)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ENVELOPE_MASTER_KEY=
POLYGON_RPC_URL=
RELAYER_ENABLED=false
RELAYER_PRIVATE_KEY=
RELAYER_DEPLOYER_PRIVATE_KEY=
RELAYER_ADDRESS=
T3X_SKILL_RATINGS_CONTRACT_ADDRESS=
SITE_BASE=https://uni.talent3x.io
